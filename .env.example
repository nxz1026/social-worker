# 社工知识库 · Cognee 服务端配置模板
# 用法：复制成 .env 并填值。.env 已在 .gitignore 里，不要提交。
# 路径（服务器）: /srv/social-work/.env
# 存储/向量/图谱全本地: sqlite + kuzu + lancedb + fastembed + GLiNER
# 注意：Cognee 侧全本地，但 scan-inbox 分类与 /api/generate 文书生成会调用外部 LLM（见文末）

# ---------- 存储后端（全本地文件，无需 Neo4j / Postgres）----------
DB_PROVIDER=sqlite
DB_NAME=
GRAPH_DATABASE_PROVIDER=kuzu
GRAPH_DATASET_DATABASE_HANDLER=lance
VECTOR_DB_PROVIDER=lancedb
VECTOR_DATASET_DATABASE_HANDLER=lance

# ---------- 多用户与权限 ----------
ENABLE_BACKEND_ACCESS_CONTROL=true
REQUIRE_AUTHENTICATION=true
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=
# 三个 secret 一旦设定就不要改，改了会导致已登录会话全部失效
FASTAPI_USERS_JWT_SECRET=
FASTAPI_USERS_RESET_PASSWORD_TOKEN_SECRET=
FASTAPI_USERS_VERIFICATION_TOKEN_SECRET=
JWT_LIFETIME_HOURS=72
HASH_API_KEY=false

# ---------- 嵌入模型（本地中文）----------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512

# ---------- 图谱抽取（强制本地 GLiNER；Cognee 侧不外发，分类/生成另见文末）----------
GRAPH_EXTRACTOR=gliner_demo
AUTO_FEEDBACK=false
TELEMETRY_DISABLED=true

# ---------- 溯源 / 版本追踪 ----------
PROVENANCE_TRACKING=true
EDGE_EVIDENCE_ENABLED=true

# ---------- 图片（本地 OCR 识别发票/表格；生活照片仍只按文件名检索）----------
IMAGE_OCR_ENABLED=true
IMAGE_EXTRACTION_ENABLED=false

# ---------- 安全 ----------
ACCEPT_LOCAL_FILE_PATH=true
COGNEE_ALLOWED_LOCAL_FILE_ROOTS=/srv/social-work
ALLOW_HTTP_REQUESTS=false
ALLOW_CYPHER_QUERY=false
RAISE_INCREMENTAL_LOADING_ERRORS=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000

# ---------- 数据目录（容器内路径）----------
DATA_ROOT_DIRECTORY=/cognee-storage/data
SYSTEM_ROOT_DIRECTORY=/cognee-storage/system

# ---------- 服务 ----------
HTTP_PORT=8000
BIND_ADDRESS=0.0.0.0
LITELLM_LOG=ERROR
ENABLE_AUTO_MIGRATIONS=true

# ------------------------------------------------------------
# LLM（接入后：实体抽取更准、支持自然语言问答）
# 注意：接入后文档内容会发送到该服务商。社工个案资料涉隐私，
#      涉隐私内容请走全本地（注释掉下面 5 行即可回退）。
# ------------------------------------------------------------
LLM_PROVIDER=custom
LLM_MODEL=openai/<模型名>
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MAX_COMPLETION_TOKENS=8192
